<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About us</title>

    <link rel="stylesheet" href="style.css" />

    <style>
      body {
        color: white;
      }

      .services {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        margin: 2rem 0;
        height: 100%;
        background-color: white;

        @media screen and (max-width: 400px) {
          margin: 0;
        }
      }

      .card .img {
        height: 100px;
        width: 100px;
      }

      .card .img img {
        height: 100%;
        width: 100%;
      }

      .services .card {
        width: 300px;
        min-height: 300px;
        padding: 10px 20px;
        border: 1px solid white;
        background-color: #7280d8;
        @media screen and (min-width: 1024px) {
          width: 350px;
          min-height: 400px;
          height: 400px;
        }

        @media screen and (min-width: 1400px) {
          width: 350px;
          min-height: 450px;
          height: 450px;
        }
        @media screen and (max-width: 400px) {
          width: 100%;
          height: auto;
          border-left-style: none;
          border-right-style: none;
          border-top-style: none;
        }
      }

      .services .card:hover {
        background-color: white;
        color: #020403;
        transition: 0.3s ease-in-out;
      }

      .services .card button:hover {
        border: 1px solid black;
      }

      .card h2 {
        margin-bottom: 1rem;
        text-transform: uppercase;
        border-bottom: 2px solid white;
        @media screen and (max-width: 400px) {
          border: none;
        }
      }

      .card p {
        margin-bottom: 1rem;
      }

      .card button {
        padding: 10px 20px;
        background-color: black;
        cursor: pointer;
        border: 1px solid #020403;
      }

      .about-heading {
        background-color: #7280d8;
        padding: 1.5rem 2rem;
      }

      .about-heading h2 {
        font-size: 2rem;
        margin-bottom: 1.5rem;
      }

      .about-heading p {
        font-size: 1.2rem;
        line-height: 1.5rem;
        color: black;
      }

      nav > a {
        color: white;
      }
      * {
        padding: 0;
        margin: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }

      .mobile-nav {
        box-shadow: 2px 4px 4px rgba(52, 52, 52, 1);
        background: #7280d8;
        border-bottom: none;
      }
      .mobile-nav a {
        color: white;
        border-bottom: none;
        &:hover {
          color: black;
        }
      }
    </style>
  </head>

  <body>
    <div class="body">
      <div class="logo" style="background-color: #7280d8">
        <h3 style="color: #020403">
          hola<span style="color: white">AMIGO</span>
        </h3>

        <nav class="desktop-nav">
          <a href="/room">Convo</a>
          <a href="/about">About us</a>
          <a href="/contact">Feedback</a>
        </nav>

        <div class="mobile-menu">
          <div class="hamburger" onclick="toggleMenu()">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <nav class="mobile-nav" id="mobileNav">
            <a href="/room">Convo</a>
            <a href="/about">About us</a>
            <a href="/contact">Feedback</a>
          </nav>
        </div>
      </div>

      <div class="about-main">
        <div class="services">
          <div class="card">
            <h2>Developer</h2>
            <p>
              My name is Rankush, and I'm the developer behind this project.
              I've created this video chat web app with a passion for providing
              users with a seamless communication experience
            </p>
          </div>

          <div class="card">
            <h2>Our Mission</h2>
            <p>
              The mission of this project is to offer a simple yet effective
              video chat solution that allows users to connect with others
              effortlessly, whether for personal or professional purposes.
            </p>
          </div>

          <div class="card">
            <h2>Key Features</h2>
            <p>This video chat web app comes with the following features:</p>
            <ul>
              <li>High-quality video and audio</li>
              <li>Easy-to-use interface</li>
              <li>Instant messaging during calls</li>
              <li>No need for downloads or installations</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <script>
      function toggleMenu() {
        document.getElementById("mobileNav").classList.toggle("active");
        document.querySelector(".hamburger").classList.toggle("active");
      }
    </script>
  </body>
</html>
