<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>hola-Amigo</title>
    <link rel="stylesheet" href="style.css" />

    <style>
      body {
        background-color: black;
      }

      * {
        padding: 0;
        margin: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }
    </style>
  </head>

  <body>
    <div class="body">
      <div class="logo">
        <h3>hola<span>AMIGO</span></h3>

        <nav class="desktop-nav">
          <a href="/room">Convo</a>
          <a href="/about">About us</a>
          <a href="/contact">Feedback</a>
        </nav>

        <div class="mobile-menu">
          <div class="hamburger" onclick="toggleMenu()">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <nav class="mobile-nav" id="mobileNav">
            <a href="/room">Convo</a>
            <a href="/about">About us</a>
            <a href="/contact">Feedback</a>
          </nav>
        </div>
      </div>

      <div class="home-main">
        <div class="left">
          <h2>Step into <span class="text-h">Hola Amigo</span></h2>
          <p>
            where every 'Hola' opens doors to seamless video connections.
            Effortlessly catch up with loved ones worldwide with our crisp,
            reliable video calls. Join our community for immersive conversations
            that bridge any distance. Start chatting today and feel the warmth
            of friendship!"
          </p>

          <a href="/room"><button class="start">Start Convo</button></a>
        </div>

        <div class="right">
          <div class="cards">
            <div class="one">
              <img src="/img/text_chat.png" alt="chat" />
            </div>

            <div class="row">
              <div class="one">
                <img src="/img/video_chat.png" alt="video-chat" />
              </div>

              <div class="one">
                <img src="/img/screenshare.png" alt="screenshare" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script>
      function toggleMenu() {
        document.getElementById("mobileNav").classList.toggle("active");
        document.querySelector(".hamburger").classList.toggle("active");
      }
    </script>
  </body>
</html>
