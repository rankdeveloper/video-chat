<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>hola-amigo | Video Chat</title>
    <link rel="stylesheet" href="style.css" />
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://kit.fontawesome.com/c939d0e917.js"></script>
    <script src="https://unpkg.com/peerjs@1.3.1/dist/peerjs.min.js"></script>
    <script>
      const ROOM_ID = "<%= roomId %>";
    </script>

    <style>
      .logo {
        background-color: #7280d8;
        /* border-bottom: 1px solid whitesmoke; */
        border: none;

        @media screen and (max-width: 400px) {
          border: none;
        }
      }

      .logo h3 {
        color: white;
        font-size: 2rem;
      }

      nav a {
        padding: 0.5rem;
        margin-left: 1rem;
        text-decoration: none;
        color: white;
        border-right: 1px solid #7280d8;
        border-radius: 5px;
      }

      nav a:hover {
        color: white;
        border-right: 1px solid white;
        transition: 0.5s ease;
      }

      .options__button {
        position: relative;
      }

      i[data-tooltip]:hover::after {
        content: attr(data-tooltip);
        position: absolute;
        color: white;
        width: 10rem;
        text-align: right;
        font-weight: normal;
        margin-left: 7rem;
        font-size: 1rem;
        text-align: center;
        transform: translateX(-80%);
        font-size: 15px;
        z-index: 1;
        font-family: Arial, Helvetica, sans-serif;
      }
      * {
        padding: 0;
        margin: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }

      .mobile-nav {
        box-shadow: 2px 4px 4px rgba(52, 52, 52, 1);
        background: #7280d8;
        border-bottom: none;
      }
      .mobile-nav a {
        color: white;
        border-bottom: none;
        &:hover {
          color: black;
        }
      }
      .main {
        border-top: 1px solid white;
      }
    </style>
  </head>

  <body>
    <div class="body" id="body">
      <div class="logo" style="background-color: #7280d8">
        <h3 style="color: #020403">
          hola<span style="color: white">AMIGO</span>
        </h3>

        <nav class="desktop-nav">
          <a href="/room">Convo</a>
          <a href="/about">About us</a>
          <a href="/contact">Feedback</a>
        </nav>
        <div class="header__back">
          <i class="fas fa-angle-left"></i>
        </div>

        <div class="mobile-menu">
          <div class="hamburger" onclick="toggleMenu()">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <nav class="mobile-nav" id="mobileNav">
            <a href="/room">Convo</a>
            <a href="/about">About us</a>
            <a href="/contact">Feedback</a>
          </nav>
        </div>
      </div>
      <div class="main">
        <div class="main__right">
          <h2>Messages</h2>
          <div class="main__chat_window">
            <div class="messages"></div>
          </div>
          <div class="main__message_container">
            <input
              id="chat_message"
              type="text"
              autocomplete="off"
              placeholder="Type message here..."
            />
            <div id="send" class="options__button">
              <i class="fas fa-paper-plane"></i>
            </div>
          </div>
        </div>

        <div class="dialog" style="display: none">
          <h2>Dialog box</h2>
        </div>
        <div class="main__left">
          <div class="videos__group">
            <div id="video-grid"></div>
          </div>
          <div class="options">
            <div class="options__left">
              <div id="stopVideo" class="options__button">
                <i class="fa fa-video-camera" data-tooltip="Hide camera"></i>
              </div>

              <div id="muteButton" class="options__button">
                <i class="fa fa-microphone" data-tooltip="Mute"></i>
              </div>

              <div id="startRecording" class="options__button">
                <i
                  class="fas fa-circle"
                  onclick="startRecording()"
                  data-tooltip="Recording"
                ></i>
              </div>

              <div id="stopRecording" class="options__button">
                <i
                  class="fas fa-stop-circle"
                  onclick="stopRecording()"
                  data-tooltip="Stop recording"
                ></i>
              </div>

              <div id="" class="options__button">
                <i
                  class="fas fa-desktop"
                  id="screenShareButton"
                  data-tooltip="Screen-share"
                ></i>
              </div>
              <div id="showChat" class="options__button">
                <i class="fa fa-comment"></i>
              </div>
            </div>
            <div class="options__right">
              <div id="inviteButton" class="options__button">
                <i class="fas fa-user-plus"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="custom-prompt" class="prompt-overlay" style="display: none">
      <div class="prompt-modal">
        <h3>Enter your name :</h3>
        <input type="text" id="prompt-input" placeholder="Your name..." />
        <button id="prompt-btn">Continue</button>
      </div>
    </div>

    <div
      id="nameModal"
      style="
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
      "
    >
      <div
        style="
          background: #fff;
          padding: 30px 40px;
          border-radius: 8px;
          box-shadow: 0 2px 10px #0003;
          text-align: center;
        "
      >
        <h2>Enter your name</h2>
        <input
          type="text"
          id="customNameInput"
          placeholder="Your name"
          style="padding: 8px; width: 80%; margin-bottom: 10px"
        />
        <br />
        <button id="customNameSubmit" style="padding: 8px 20px">Join</button>
      </div>
    </div>
  </body>
  <script>
    function toggleMenu() {
      document.getElementById("mobileNav").classList.toggle("active");
      document.querySelector(".hamburger").classList.toggle("active");
    }
  </script>
  <script src="script.js"></script>
</html>
